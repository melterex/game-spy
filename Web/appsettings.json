{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/app-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 14
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Key": "Your_Super_Secret_Key_Needs_To_Be_Long_Enough_12345!",
        "Issuer": "YourApplication",
        "Audience": "YourApplicationUsers"
    },
    "OpenRouterApiKey": "",
    "Authentication": {
        "Yandex": {
            "ClientId": "Your_Super_Secret_ClientId",
            "ClientSecret": "Your_Super_Secret_ClientSecret"
        },
        "Vkontakte": {
            "ClientId": "Your_Super_Secret_ClientId",
            "ClientSecret": "Your_Super_Secret_ClientSecret"
        }
    }
}